# =====================================================================
# SaarthiX — environment variables
# Copy to .env.local and fill in. Never commit a filled .env file.
# =====================================================================

# --- Client-side (safe to expose, protected by RLS) ------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side ONLY -------------------------------------------------
# Set these as Supabase Edge Function secrets, never in Vercel client
# env and never in any VITE_ prefixed variable.
#
#   supabase secrets set AI_PROVIDER_API_KEY=...
#
# SUPABASE_URL                  (auto-injected into Edge Functions)
# SUPABASE_SERVICE_ROLE_KEY     (auto-injected into Edge Functions)
# AI_PROVIDER_API_KEY
# AI_PROVIDER_MODEL
