# =====================================================================
# SaarthiX — environment variables
# Copy to .env.local and fill in your own values. Never commit a filled .env file.
# =====================================================================

# --- Client-side (safe to expose to the browser; protected by RLS) ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Optional: shown on the Contact page as a mailto link. Leave unset to hide it.
VITE_CONTACT_EMAIL=

# --- Server-side ONLY (Supabase Edge Function secrets) ----------------
# Set these with the Supabase CLI — never in Vercel's client env and
# never in any VITE_ prefixed variable:
#
#   supabase secrets set AI_PROVIDER=anthropic
#   supabase secrets set AI_API_KEY=sk-...
#   supabase secrets set AI_MODEL=claude-3-5-haiku-latest
#   supabase secrets set ALLOWED_ORIGINS=https://yourapp.vercel.app
#
# SUPABASE_URL                (auto-injected into Edge Functions)
# SUPABASE_ANON_KEY           (auto-injected into Edge Functions)
# SUPABASE_SERVICE_ROLE_KEY   (auto-injected into Edge Functions)
# AI_PROVIDER      "anthropic" (default) or "openai"
# AI_API_KEY       provider secret key
# AI_MODEL         model name for the chosen provider
# ALLOWED_ORIGINS  comma-separated list of allowed origins for CORS (optional; defaults to *)
